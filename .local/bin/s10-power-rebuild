#!/usr/bin/env python3
"""S10 power menu rebuild: clean wlogout layout + style, then tidy leftovers."""
import os, re, glob, shutil, subprocess
from pathlib import Path

H = Path.home()
WL = H / ".config/wlogout"
WL.mkdir(parents=True, exist_ok=True)

# ---- 1. find what wlogout actually uses ---------------------------------
niri = (H / ".config/niri/config.kdl").read_text(errors="replace")
m = re.search(r'wlogout[^\n]*', niri)
bind = m.group(0) if m else ""
lm = re.search(r'(?:-l|--layout)"?\s*,?\s*"([^"]+)"', bind)
src_layout = None
for cand in ([os.path.expanduser(lm.group(1))] if lm else []) + [
        str(WL / "layout"), "/etc/wlogout/layout", "/usr/share/wlogout/layout"]:
    if os.path.isfile(cand):
        src_layout = cand; break
layout_txt = Path(src_layout).read_text(errors="replace") if src_layout else ""

# actions per keybind letter, from whatever layout existed
actions = {}
for blk in re.findall(r'\{[^{}]*\}', layout_txt, re.S):
    k = re.search(r'"keybind"\s*:\s*"([^"]+)"', blk)
    a = re.search(r'"action"\s*:\s*"((?:[^"\\]|\\.)*)"', blk)
    if k and a:
        actions[k.group(1)] = a.group(1)

defaults = {
    "l": "loginctl lock-session",
    "e": "niri msg action quit --skip-confirmation",
    "s": "systemctl suspend",
    "r": "systemctl reboot",
    "u": "systemctl poweroff",
}
items = [  # id, label, key
    ("lock", "Lock", "l"),
    ("logout", "Log out", "e"),
    ("suspend", "Sleep", "s"),
    ("reboot", "Restart", "r"),
    ("shutdown", "Power off", "u"),
]

# ---- 2. icons: reuse the ones already in use ------------------------------
css_srcs = [p for p in [WL / "style.css.bak", WL / "style.css"] if p.is_file()]
css_old = "\n".join(p.read_text(errors="replace") for p in css_srcs)
icon_urls = re.findall(r'url\(\s*"?([^")]+?)"?\s*\)', css_old)

def find_icon(ident, label):
    keys = {ident, label.lower().replace(" ", ""), {"suspend": "sleep", "shutdown": "poweroff",
            "reboot": "restart", "logout": "logout", "lock": "lock"}[ident],
            {"suspend": "suspend", "shutdown": "shutdown", "reboot": "reboot",
             "logout": "exit", "lock": "lock"}[ident]}
    for u in icon_urls:
        name = os.path.basename(os.path.expanduser(u)).lower()
        if any(k in name for k in keys) and os.path.isfile(os.path.expanduser(u)):
            return os.path.expanduser(u)
    for d in ["/usr/share/wlogout/icons", "/usr/local/share/wlogout/icons"]:
        p = f"{d}/{ident}.png"
        if os.path.isfile(p):
            return p
    return ""

# ---- 3. write fresh layout -----------------------------------------------
out = []
for ident, label, key in items:
    act = actions.get(key, defaults[key]).replace('"', '\\"') if key not in actions else actions[key]
    out.append('{\n    "label" : "%s",\n    "action" : "%s",\n    "text" : "%s",\n    "keybind" : "%s"\n}'
               % (ident, act, label, key))
(WL / "layout").write_text("\n".join(out) + "\n")

# ---- 4. write fresh style ------------------------------------------------
icon_css = "\n".join(
    f'#{i} {{ background-image: image(url("{find_icon(i, l)}")); }}' for i, l, _ in items)

style = f"""/* S10 power menu — clean glass */
* {{
    all: unset;
    font-family: "Inter", sans-serif;
    font-weight: 600;
}}

@keyframes s10-in {{
    from {{ opacity: 0; }}
    to   {{ opacity: 1; }}
}}

window {{
    background-color: rgba(8, 10, 14, 0.42);
    animation: s10-in 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
}}

button {{
    margin: 0 9px;
    padding-bottom: 18px;
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background-color: rgba(28, 32, 40, 0.42);
    background-repeat: no-repeat;
    background-position: center 40%;
    background-size: 26%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    letter-spacing: 0.3px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: all 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: s10-in 340ms cubic-bezier(0.2, 0.8, 0.2, 1);
}}

button:hover, button:focus {{
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.24);
    background-size: 30%;
    color: #ffffff;
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.08), 0 18px 42px rgba(0, 0, 0, 0.38),
                inset 0 1px 0 rgba(255, 255, 255, 0.12);
}}

button:active {{
    background-color: rgba(255, 255, 255, 0.18);
    background-size: 27%;
}}

#shutdown:hover, #shutdown:focus {{
    background-color: rgba(255, 90, 90, 0.12);
    border-color: rgba(255, 130, 130, 0.42);
    color: #ffdada;
    box-shadow: 0 0 26px rgba(255, 90, 90, 0.16), 0 18px 42px rgba(0, 0, 0, 0.38);
}}

{icon_css}
"""
(WL / "style.css").write_text(style)

# ---- 5. point the niri bind at these files --------------------------------
if m and "-l" not in bind and "--layout" not in bind:
    pass  # default path ~/.config/wlogout is used automatically
print("layout source :", src_layout or "none (defaults)")
print("niri bind     :", bind.strip() or "not found")
for i, l, k in items:
    print(f"  {l:10} [{k}]  icon: {find_icon(i, l) or 'MISSING'}")

# ---- 6. tidy leftovers ----------------------------------------------------
junk = []
for pat in ["~/.config/wlogout/*.bak", "~/.config/rofi/*.bak", "~/.config/rofi/*.pre-*",
            "~/.config/rofi/hero.orig.png", "~/.config/niri/*.bak", "~/Downloads/config.rasi*"]:
    junk += glob.glob(os.path.expanduser(pat))
for j in junk:
    os.remove(j)
print(f"removed {len(junk)} leftover backup files")
