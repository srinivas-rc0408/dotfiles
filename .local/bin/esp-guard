#!/bin/sh
# /usr/local/sbin/esp-guard — runs at every Linux boot. Repairs anything Windows (or a bad
# shutdown) can break on the shared EFI partition, then refreshes the known-good backup.
B=/root/esp-backup; ESP=/boot
mkdir -p "$B"
log() { echo "esp-guard: $*"; }

# 1. boot entries + loader.conf: restore if missing/empty, back up if healthy
for f in "$B"/*.conf; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  [ "$n" = loader.conf ] && t="$ESP/loader/loader.conf" || t="$ESP/loader/entries/$n"
  if [ ! -s "$t" ]; then mkdir -p "$(dirname "$t")"; cp "$f" "$t"; log "restored $t"; fi
done
for f in "$ESP"/loader/entries/*.conf "$ESP"/loader/loader.conf; do
  [ -s "$f" ] && grep -q . "$f" && cp "$f" "$B/"
done

# 2. kernel/initramfs must exist; if not, rebuild them
for k in vmlinuz-linux initramfs-linux.img vmlinuz-linux-lts initramfs-linux-lts.img; do
  if [ ! -s "$ESP/$k" ]; then log "missing $k — rebuilding"; mkinitcpio -P >/dev/null 2>&1; break; fi
done

# 3. systemd-boot binary + firmware fallback path
bootctl update --graceful >/dev/null 2>&1
SD="$ESP/EFI/systemd/systemd-bootx64.efi"; FB="$ESP/EFI/BOOT/BOOTX64.EFI"
if [ -s "$SD" ] && ! cmp -s "$SD" "$FB"; then mkdir -p "$(dirname "$FB")"; cp "$SD" "$FB"; log "fallback loader refreshed"; fi

# 4. firmware boot entries: drop stale ones pointing at partitions that no longer exist,
#    then order: Linux Boot Manager (this ESP) -> its fallback -> everything else
PU=$(blkid -s PARTUUID -o value "$(findmnt -no SOURCE "$ESP" | head -1)" | head -1)
LIVE=$(lsblk -rno PARTUUID | tr 'A-Z' 'a-z')
efibootmgr | grep -iE '^Boot[0-9a-f]{4}\*? .*HD\([0-9]+,GPT,' | while read -r line; do
  n=$(echo "$line" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p')
  p=$(echo "$line" | sed -n 's/.*HD([0-9]*,GPT,\([0-9a-fA-F-]*\),.*/\1/p' | tr 'A-Z' 'a-z')
  if [ -n "$p" ] && ! echo "$LIVE" | grep -qx "$p"; then efibootmgr -q -b "$n" -B && log "removed stale boot entry $n ($p)"; fi
done
NUM=$(efibootmgr | grep -i "Linux Boot Manager" | grep -vi Fallback | grep -i "$PU" | head -1 | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p')
FBN=$(efibootmgr | grep -i "Fallback Linux Boot Manager" | grep -i "$PU" | head -1 | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p')
if [ -n "$NUM" ]; then
  ORDER=$(efibootmgr | sed -n 's/^BootOrder: //p')
  WANT="$NUM${FBN:+,$FBN}"
  case "$ORDER" in
    "$WANT"*) ;;
    *) REST=$(echo "$ORDER" | tr ',' '\n' | grep -vix -e "$NUM" ${FBN:+-e "$FBN"} | paste -sd,)
       efibootmgr -q -o "$WANT${REST:+,$REST}" && log "boot order fixed: $WANT first" ;;
  esac
fi

# 5. menu always visible for 3 s
grep -q '^timeout' "$ESP/loader/loader.conf" 2>/dev/null || echo 'timeout 3' >> "$ESP/loader/loader.conf"
bootctl set-timeout 3 >/dev/null 2>&1
sync
