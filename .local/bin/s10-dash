#!/usr/bin/env python3
# S10 Dash: clock | calendar | music | wallpapers (Images / Live). GTK4, resident, toggled over D-Bus.
import datetime, glob, hashlib, json, math, os, shutil, socket, subprocess, sys, threading
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Pango", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango

HOME = os.path.expanduser("~")
WALL_DIRS = sorted({d for p in ("*", "*/*", "*/*/*") for d in glob.glob(f"{HOME}/{p}")
                    if os.path.isdir(d) and os.path.basename(d).lower().startswith("wallpaper")})
VDIR = f"{HOME}/Videos/wallpapers"
CURRENT = f"{HOME}/Pictures/wall.jpg"
VLINK = f"{HOME}/.config/s10/video-wall"
VWALL = f"{HOME}/.local/bin/s10-vwall"
SOCK = "/tmp/s10-mpv.sock"
THUMBS = f"{HOME}/.cache/s10-dash/thumbs"
EVENTS = f"{HOME}/.local/share/s10/events.json"
os.makedirs(os.path.dirname(EVENTS), exist_ok=True)

def load_events():
    try: return json.load(open(EVENTS))
    except Exception: return {}

def save_events(ev):
    ev = {k: v for k, v in ev.items() if v}
    tmp = EVENTS + ".tmp"; json.dump(ev, open(tmp, "w"), indent=1, ensure_ascii=False); os.replace(tmp, EVENTS)
os.makedirs(THUMBS, exist_ok=True)
os.makedirs(os.path.dirname(VLINK), exist_ok=True)

