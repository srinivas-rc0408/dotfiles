#!/bin/sh
P=/tmp/s10-clock-last
PID=$(cat /tmp/s10-clockd.pid 2>/dev/null)
now=$(date +%s%N)
last=$(cat "$P" 2>/dev/null || echo 0)
if [ $(( (now - last) / 1000000 )) -lt 450 ]; then
  rm -f "$P"
  kill -USR2 "$PID" 2>/dev/null
  exec "$HOME/.local/bin/s10-dash-toggle"
fi
echo "$now" > "$P"
kill -USR1 "$PID" 2>/dev/null
