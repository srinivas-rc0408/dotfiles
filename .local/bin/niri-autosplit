#!/usr/bin/env python3
# Evenly split tiled columns on the focused workspace when the column count changes.
import json, subprocess

def query(what):
    out = subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True).stdout
    return json.loads(out) if out else []

def act(*args):
    subprocess.run(["niri", "msg", "action", *args], capture_output=True)

last = {}

def rebalance():
    try:
        wins = query("windows")
    except Exception:
        return
    focused = next((w for w in wins if w.get("is_focused")), None)
    if not focused or focused.get("is_floating"):
        return
    ws = focused.get("workspace_id")
    cols = {}
    for w in wins:
        if w.get("workspace_id") != ws or w.get("is_floating"):
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos:
            cols.setdefault(pos[0], w["id"])
    n = len(cols)
    if n == 0 or last.get(ws) == n:
        return
    last[ws] = n
    if n > 3:
        return
    width = {1: "100%", 2: "50%", 3: "33.333%"}[n]
    for wid in cols.values():
        act("focus-window", "--id", str(wid))
        act("set-column-width", width)
    act("focus-window", "--id", str(focused["id"]))

rebalance()
proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
for line in proc.stdout:
    if "WindowOpenedOrChanged" in line or "WindowClosed" in line:
        rebalance()
