#!/usr/bin/python3
"""
niri-autosplit — pair layout for every workspace.

  1 window   -> full screen
  2 windows  -> half | half
  3 windows  -> half | half | FULL (opens to the right, view scrolls to it)
  4 windows  -> half | half | half | half   (two "screens" of two)
  ...and so on: windows always come in screen-wide pairs; an odd last one is full width.

Only runs when a workspace's column count changes (open / close / stack / unstack),
so any width you set by hand (Mod+Minus / Mod+Equal / Mod+R / mouse) stays until then.
Stacking two windows in one column (Mod+[ / Mod+]) counts as one column, so you can do
"one left half + two stacked on the right half".
Resizes by window id: focus never jumps.
"""
import json, subprocess

def query(what):
    out = subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True).stdout
    return json.loads(out) if out else []

def set_width(wid, width):
    subprocess.run(["niri", "msg", "action", "set-window-width", "--id", str(wid), width],
                   capture_output=True)

last = {}

def rebalance():
    try:
        wins = query("windows")
    except Exception:
        return
    per_ws = {}
    for w in wins:
        if w.get("is_floating") or w.get("workspace_id") is None:
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if not pos:
            continue
        per_ws.setdefault(w["workspace_id"], {}).setdefault(pos[0], w["id"])   # one id per column
    for ws in list(last):
        if ws not in per_ws:
            del last[ws]                         # workspace emptied: reset its memory
    for ws, cols in per_ws.items():
        n = len(cols)
        if last.get(ws) == n:
            continue
        last[ws] = n
        ordered = [cols[k] for k in sorted(cols)]
        for i, wid in enumerate(ordered):
            alone = (i == n - 1) and (n % 2 == 1)   # unpaired last column
            set_width(wid, "100%" if alone else "50%")

rebalance()
proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
for line in proc.stdout:
    if line.startswith(('{"WindowOpenedOrChanged', '{"WindowClosed', '{"WindowsChanged', '{"WindowLayoutsChanged')):
        rebalance()
