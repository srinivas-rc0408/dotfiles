#!/usr/bin/env bash
pkill -f "kitty --class s10-cal" && exit 0
setsid -f kitty --class s10-cal -o background_opacity=0.45 -o font_size=12 \
  -o "font_family=JetBrainsMono Nerd Font" -o window_padding_width=16 \
  -o confirm_os_window_close=0 -o remember_window_size=no \
  -o initial_window_width=30c -o initial_window_height=16c \
  "$HOME/.local/bin/calview" >/dev/null 2>&1
setsid -f python3 - <<"PY" >/dev/null 2>&1
import json, subprocess, time
seen = False
for _ in range(1200):
    time.sleep(0.15)
    out = subprocess.run(["niri","msg","--json","focused-window"],capture_output=True,text=True).stdout
    try: app = (json.loads(out) or {}).get("app_id")
    except Exception: app = None
    if app == "s10-cal": seen = True
    elif seen:
        subprocess.run(["pkill","-f","kitty --class s10-cal"]); break
    if seen and subprocess.run(["pgrep","-f","kitty --class s10-cal"],capture_output=True).returncode: break
PY
