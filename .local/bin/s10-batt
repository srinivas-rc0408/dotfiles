#!/usr/bin/env bash
# s10-batt — capture power state (run once on charger, once on battery) -> ~/Downloads/s10-batt-<ac|bat>.txt
ac=0; for p in /sys/class/power_supply/*; do [ "$(cat $p/type 2>/dev/null)" = Mains ] && [ "$(cat $p/online)" = 1 ] && ac=1; done
tag=$([ $ac = 1 ] && echo ac || echo bat); out="$HOME/Downloads/s10-batt-$tag.txt"
sec() { printf '\n===== %s =====\n' "$1"; }
{
sec "state"; echo "on: $tag"; date
sec "power managers"; for u in tlp power-profiles-daemon auto-cpufreq thermald asusd supergfxd power-mode cpu-power-cap cpupower; do printf '%-24s enabled=%-10s active=%s\n' $u "$(systemctl is-enabled $u 2>&1)" "$(systemctl is-active $u 2>&1)"; done
cat /etc/default/cpupower 2>/dev/null | grep -v '^#' | grep .
sec "cpu"; cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference
echo "no_turbo=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo) max_perf=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct) min_perf=$(cat /sys/devices/system/cpu/intel_pstate/min_perf_pct)"
echo "scaling_max=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq) cpuinfo_max=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)"
grep MHz /proc/cpuinfo | awk '{s+=$4;n++} END{printf "avg now: %.0f MHz\n", s/n}'
sec "rapl limits"; R=/sys/class/powercap/intel-rapl:0; echo "PL1=$(( $(cat $R/constraint_0_power_limit_uw)/1000000 ))W PL2=$(( $(cat $R/constraint_1_power_limit_uw)/1000000 ))W"
sec "platform"; cat /sys/firmware/acpi/platform_profile 2>/dev/null; asusctl profile get 2>/dev/null; supergfxctl -g 2>/dev/null; supergfxctl -S 2>/dev/null
sec "gpu"; cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status 2>/dev/null; cat /sys/class/drm/card*/device/power_dpm_force_performance_level 2>/dev/null
for f in /sys/class/drm/card*/gt_cur_freq_mhz /sys/class/drm/card*/gt_max_freq_mhz /sys/class/drm/card*/gt_RPn_freq_mhz; do [ -f $f ] && echo "$f=$(cat $f)"; done
sec "display"; niri msg outputs 2>/dev/null | grep -E 'Current mode|Variable refresh' 
sec "pcie aspm / usb"; cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null; cat /sys/module/usbcore/parameters/autosuspend
sec "wifi"; iw dev 2>/dev/null | awk '/Interface/{print $2}' | while read i; do iw dev $i get power_save; done
sec "battery"; for b in /sys/class/power_supply/BAT*; do echo "capacity=$(cat $b/capacity)% status=$(cat $b/status) power_now=$(( $(cat $b/power_now 2>/dev/null || echo 0)/1000000 ))W"; done
sec "load"; uptime; ps -eo pcpu,rss,comm --sort=-pcpu | head -12
sec "throttling"; journalctl -k -b --no-pager | grep -iE 'throttl|cpu clock|thermal' | tail -10
sec "tlp"; command -v tlp-stat >/dev/null && sudo -n tlp-stat -s 2>/dev/null | head -20
} > "$out" 2>&1
echo "written: $out"
