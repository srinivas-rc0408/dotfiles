#!/usr/bin/env bash
# s10-power — centered glass power menu.  Keys: L lock · E log out · S sleep · R restart · U power off
THEME="$HOME/.config/rofi/power.rasi"
pkill -f 'rofi.*power.rasi' && exit 0
pkill -f 'rofi -show (wifi|bt|audio)'; pkill -x wlogout

up=$(uptime -p | sed 's/^up //; s/ hours\?/h/; s/ minutes\?/m/; s/,//g')
bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
tile() { printf '<span font="JetBrainsMono Nerd Font 26">%s</span>\n<span font="Inter SemiBold 10.5">%s</span>\n<span font="Inter Medium 8" alpha="38%%">%s</span>|' "$1" "$2" "$3"; }
menu=$(tile '󰌾' 'Lock' 'L'; tile '󰍃' 'Log out' 'E'; tile '󰒲' 'Sleep' 'S'; tile '󰜉' 'Restart' 'R'; tile '󰐥' 'Power off' 'U')

idx=$(printf '%s' "${menu%|}" | rofi -dmenu -sep '|' -format i -markup-rows -no-custom -i -eh 5 \
  -theme "$THEME" -mesg "<span alpha='55%'>up $up   ·   battery ${bat}%</span>" \
  -kb-custom-1 l -kb-custom-2 e -kb-custom-3 s -kb-custom-4 r -kb-custom-5 u \
  -kb-row-left Left -kb-row-right Right -kb-move-char-back "" -kb-move-char-forward "" \
  -hover-select -me-select-entry MouseSecondary -me-accept-entry MousePrimary -click-to-exit \
  -kb-cancel "Escape,Super_L")
rc=$?
case $rc in 10|11|12|13|14) idx=$((rc - 10)) ;; 0) ;; *) exit 0 ;; esac

sleep 0.12   # let the menu close before acting
case $idx in
  0) pidof hyprlock >/dev/null || setsid -f hyprlock ;;
  1) niri msg action quit --skip-confirmation ;;
  2) systemctl suspend ;;
  3) systemctl reboot ;;
  4) systemctl poweroff ;;
esac
