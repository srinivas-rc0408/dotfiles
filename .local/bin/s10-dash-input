#!/usr/bin/env python3
# Passive mouse watcher: a click outside S10 Dash closes it. Never intercepts input.
import json, os, select, subprocess, time
import evdev
from evdev import ecodes as e
TOGGLE = os.path.expanduser("~/.local/bin/s10-dash-toggle")

def niri(cmd):
    out = subprocess.run(["niri", "msg", "--json", cmd], capture_output=True, text=True).stdout
    try: return json.loads(out)
    except Exception: return None

def mice():
    out = []
    for p in evdev.list_devices():
        try:
            d = evdev.InputDevice(p)
            if e.BTN_LEFT in d.capabilities().get(e.EV_KEY, []): out.append(d)
        except Exception:
            pass
    return {d.fd: d for d in out}

devs, rescan = mice(), time.time()
while True:
    if time.time() - rescan > 10:
        devs, rescan = mice(), time.time()
    r, _, _ = select.select(list(devs), [], [], 2)
    for fd in r:
        try: events = list(devs[fd].read())
        except OSError: continue
        if not any(ev.type == e.EV_KEY and ev.code == e.BTN_LEFT and ev.value == 1 for ev in events): continue
        time.sleep(0.08)
        if any(w.get("app_id") == "dev.s10.dash" for w in (niri("windows") or [])):
            if (niri("focused-window") or {}).get("app_id") != "dev.s10.dash":
                subprocess.Popen([TOGGLE], start_new_session=True)
