#!/bin/sh
# Convert any new wallpaper videos into ~/Videos/wallpapers (1080p, 30fps, muted) and refresh the dashboard.
SRC="${1:-$HOME/Downloads/wallpaper}"; OUT="$HOME/Videos/wallpapers"; mkdir -p "$OUT"
n=0
find "$SRC" -type f \( -iname "*.mp4" -o -iname "*.webm" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.gif" \) | while IFS= read -r f; do
  base=$(basename "$f"); name=$(printf "%s" "${base%.*}" | tr "[:upper:]" "[:lower:]" | sed "s/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//; s/-[0-9]\{3,4\}x[0-9]\{3,4\}//")
  [ "$name" = preview ] && name=$(basename "$(dirname "$f")" | tr "[:upper:]" "[:lower:]" | sed "s/[^a-z0-9]\{1,\}/-/g")
  out="$OUT/$name.mp4"
  [ -s "$out" ] && continue
  printf "converting  %s\n" "$name"
  nice -n 15 ffmpeg -nostdin -loglevel error -y -i "$f" -an \
    -vf "scale=1920:1080:force_original_aspect_ratio=increase:flags=lanczos,crop=1920:1080,fps=30" \
    -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -movflags +faststart "$out" || rm -f "$out"
done
pkill -f "s10-dash --hidden"; sleep 0.5; setsid -f "$HOME/.local/bin/s10-dash" --hidden
echo "done. library:"; ls "$OUT"
