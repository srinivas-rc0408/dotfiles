/* S10 power menu — centered glass row, matches launcher / dashboard */
* {
  font: "Inter Medium 10";
  background-color: transparent; text-color: #ffffff;
  margin: 0; padding: 0; spacing: 0; border: 0;
}
window {
  location: center; anchor: center;
  width: 760px; padding: 22px;
  background-color: rgba(20, 24, 32, 0.55);
  border: 1px; border-color: rgba(255, 255, 255, 0.12);
  border-radius: 30px;
}
mainbox { spacing: 16px; children: [ listview, message ]; }
message { padding: 0 4px; }
textbox { font: "Inter 9.5"; horizontal-align: 0.5; text-color: rgba(255,255,255,0.6); }
listview {
  layout: horizontal; columns: 5; lines: 1; spacing: 12px;
  fixed-columns: true; scrollbar: false; cycle: true;
}
element {
  orientation: vertical;
  padding: 26px 0 20px 0; border-radius: 22px; cursor: pointer;
  border: 1px; border-color: rgba(255, 255, 255, 0.07);
  background-color: rgba(255, 255, 255, 0.04);
}
element selected.normal {
  background-color: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.30);
}
element-text {
  horizontal-align: 0.5; vertical-align: 0.5;
  text-color: rgba(255, 255, 255, 0.72);
}
element selected.normal element-text { text-color: #ffffff; }
