/* S10 Wi-Fi menu — glass panel under the bar, matching launcher/dashboard */
configuration { show-icons: false; hover-select: true; me-select-entry: "MouseSecondary"; me-accept-entry: "MousePrimary"; click-to-exit: true; }
* {
  font: "Inter Medium 10.5";
  background-color: transparent;
  text-color: #ffffff;
  margin: 0; padding: 0; spacing: 0; border: 0;
}
window {
  location: northeast; anchor: northeast;
  x-offset: -12px; y-offset: 50px;
  width: 380px;
  padding: 14px;
  background-color: rgba(20, 24, 32, 0.62);
  border: 1px; border-color: rgba(255, 255, 255, 0.12);
  border-radius: 22px;
}
mainbox { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar {
  padding: 10px 14px; spacing: 10px;
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px; border-color: rgba(255, 255, 255, 0.10);
  border-radius: 14px;
  children: [ prompt, entry ];
}
prompt { font: "JetBrainsMono Nerd Font 12"; }
entry { placeholder: "Search networks"; placeholder-color: rgba(255,255,255,0.38); cursor: text; }
message { padding: 2px 6px; }
textbox { font: "Inter 9.5"; text-color: rgba(255,255,255,0.55); }
listview { lines: 9; spacing: 3px; scrollbar: false; fixed-height: false; dynamic: true; }
element {
  padding: 10px 12px; border-radius: 12px; cursor: pointer;
  border: 1px; border-color: transparent;
}
element normal.normal, element alternate.normal, element normal.active, element alternate.active { background-color: transparent; }
element selected.normal, element selected.active {
  background-color: rgba(255, 255, 255, 0.11);
  border-color: rgba(255, 255, 255, 0.16);
}
element-text { font: "JetBrainsMono Nerd Font 10.5"; text-color: rgba(255,255,255,0.80); vertical-align: 0.5; }
element selected.normal element-text { text-color: #ffffff; }
